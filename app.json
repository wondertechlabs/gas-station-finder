{
  "expo": {
    "name": "Gasolineras",
    "slug": "gas-station-near-me",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gas-station-near-me",
    "userInterfaceStyle": "automatic",
    "jsEngine": "hermes",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.donmanuel.gas-station-near-me",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Con el acceso a tu ubicación, podremos mostrar las gasolineras cercanas a ti.",
        "NSLocationAlwaysUsageDescription": "Con el acceso a tu ubicación, podremos mostrar las gasolineras cercanas a ti.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "googleMapsApiKey": "process.env.EXPO_PUBLIC_GOOGLE_MAPS_API_KEY"
      },
      "jsEngine": "jsc"
    },
    "android": {
      "package": "dev.donmanuel.gas_station_near_me",
      "config": {
        "googleMaps": {
          "apiKey": "process.env.EXPO_PUBLIC_GOOGLE_MAPS_API_KEY"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "config": {
        "googleMapsApiKey": "process.env.EXPO_PUBLIC_GOOGLE_MAPS_API_KEY"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Con el acceso a tu ubicación, podremos mostrar las gasolineras cercanas a ti."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3e60f601-fd0a-451c-9dd6-ab95cf0919a8"
      }
    },
    "owner": "donmanuel"
  }
}
