{
  "expo": {
    "name": "Gasolineras",
    "slug": "gas-station-near-me",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gas-station-near-me",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.donmanuel.gas-station-near-me",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Con el acceso a tu ubicación, podremos mostrar las gasolineras cercanas a ti",
        "NSLocationAlwaysUsageDescription": "Con el acceso a tu ubicación, podremos mostrar las gasolineras cercanas a ti",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Con el acceso a tu ubicación, podremos mostrar las gasolineras cercanas a ti."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3e60f601-fd0a-451c-9dd6-ab95cf0919a8"
      }
    },
    "owner": "manuelduarte077",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3e60f601-fd0a-451c-9dd6-ab95cf0919a8"
    },
    "android": {
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    }
  }
}
