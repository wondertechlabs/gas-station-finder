# Google Maps API Key
# Obtén tu API Key en: https://console.cloud.google.com/
# Habilita las siguientes APIs:
# - Places API
# - Maps JavaScript API
# - Geocoding API

EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=tu_api_key_aqui

# Google Maps SDK for Android (lo usa expo-maps en Android).
# Restringe esta key al paquete Android y a la huella SHA-1 de la app.
GOOGLE_MAPS_ANDROID_API_KEY=tu_api_key_android_aqui
