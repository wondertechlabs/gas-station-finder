### TanStack Query Best Practices
```typescript
// ✅ GOOD: Proper error handling with loading states
export const RestaurantList = () => {
  const { data: restaurants, isLoading, error, refetch } = useRestaurants();
  
  if (isLoading) {
    return (
      <View className="flex-1 items-center justify-center">
        <ActivityIndicator size="large" color="#22C55E" />
        <Text className="mt-4 text-gray-600">Loading restaurants...</Text>
      </View>
    );
  }
  
  if (error) {
    return (
      <View className="flex-1 items-center justify-center p-4">
        <Text className="text-red-600 text-center mb-4">
          Failed to load restaurants
        </Text>
        <Button title="Retry" onPress={() => refetch()} />
      </View>
    );
  }
  
  return (
    <FlatList
      data={restaurants}
      keyExtractor={(item) => item.id}
      renderItem={({ item }) => <RestaurantCard restaurant={item} />}
      className="flex-1"
    />
  );
};

// ✅ GOOD: Optimistic updates for better UX
export const useUpdateRestaurant = () => {
  const queryClient = useQueryClient();
  
  return useMutation({
    mutationFn: restaurantAPI.updateRestaurant,
    onMutate: async (updatedRestaurant) => {
      // Cancel outgoing refetches
      await queryClient.cancelQueries({ queryKey: restaurantKeys.detail(updatedRestaurant.id) });
      
      // Snapshot previous value
      const previousRestaurant = queryClient.getQueryData(
        restaurantKeys.detail(updatedRestaurant.id)
      );
      
      // Optimistically update cache
      queryClient.setQueryData(
        restaurantKeys.detail(updatedRestaurant.id),
        updatedRestaurant
      );
      
      // Return context for rollback
      return { previousRestaurant };
    },
    onError: (err, updatedRestaurant, context) => {
      // Rollback on error
      if (context?.previousRestaurant) {
        queryClient.setQueryData(
          restaurantKeys.detail(updatedRestaurant.id),
          context.previousRestaurant
        );
      }
    },
    onSettled: (_, __, updatedRestaurant) => {
      // Always refetch after error or success
      queryClient.invalidateQueries({ 
        queryKey: restaurantKeys.detail(updatedRestaurant.id) 
      });
    },
  });
};

// ✅ GOOD: Infinite scroll with proper loading states
export const InfiniteRestaurantList = () => {
  const {
    data,
    fetchNextPage,
    hasNextPage,
    isFetchingNextPage,
    isLoading,
    error,
  } = useInfiniteRestaurants();
  
  const loadMore = () => {
    if (hasNextPage && !isFetchingNextPage) {
      fetchNextPage();
    }
  };
  
  const renderFooter = () => {
    if (!isFetchingNextPage) return null;
    
    return (
      <View className="py-4 items-center">
        <ActivityIndicator size="small" color="#22C55E" />
        <Text className="mt-2 text-gray-600">Loading more...</Text>
      </View>
    );
  };
  
  return (
    <FlatList
      data={data?.pages.flatMap(page => page.restaurants) || []}
      keyExtractor={(item) => item.id}
      renderItem={({ item }) => <RestaurantCard restaurant={item} />}
      onEndReached={loadMore}
      onEndReachedThreshold={0.5}
      ListFooterComponent={renderFooter}
      className="flex-1"
    />
  );
};
```

### Performance Optimization
```typescript
// Use memo for components with complex className logic
export const OptimizedButton = memo(({ variant, size, disabled, children }) => {
  const buttonClasses = useMemo(() => {
    const base = 'flex-row items-center justify-center rounded-lg font-semibold';
    const variantClasses = {
      primary: 'bg-primary-500 text-white',
      secondary: 'bg-secondary-100 text-secondary-700',
    };
    
    return `${base} ${variantClasses[variant]} ${disabled ? 'opacity-50' : ''}`;
  }, [variant, disabled]);

  return (
    <TouchableOpacity className={buttonClasses}>
      {children}
    </TouchableOpacity>
  );
});
